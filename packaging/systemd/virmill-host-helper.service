[Unit]
Description=Virmill bounded privileged helper
Requires=virmill-host-helper.socket

[Service]
ExecStart=/usr/libexec/virmill-host-helper
User=root
Group=root
UMask=0077
StateDirectory=virmill-host-helper
StateDirectoryMode=0700
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
