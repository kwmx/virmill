[Unit]
Description=Virmill local coordinator
# Your own VMs need a libvirt daemon that this hardened service did not start
# (ADR 0064). The socket is ready before the coordinator decides at startup
# whether it can start VMs on qemu:///session.
Wants=virmill-virtqemud.socket
After=virmill-virtqemud.socket

[Service]
Type=simple
ExecStart=/usr/bin/virmilld
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
# User-service PrivateTmp implicitly remaps host UIDs, breaking root-owned tool
# verification and helper peer identity. Untrusted workers have their own sandbox.
PrivateTmp=no

[Install]
WantedBy=default.target
