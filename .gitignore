# Local toolchain, build products and test output. Vendor source stays tracked
# because the pinned build must work offline.
/.tools
/build/
/dist/
/bin/
/coverage/
/virmill
/virmilld
/virmill-host-helper
*.test
coverage.out
*.prof
*.rpm
*.deb
*.o
*.a
*.so
*.so.*
*.efi
*.EFI

# Machine-specific test configuration, downloaded media and application state.
# Keep fixture recipes and text manifests in tests/fixtures/ under version control.
/.virmill-local/
/images/
/artifacts/
/tmp/
/.cache/
*.iso
*.ova
*.7z
*.qcow
*.qcow2
*.vmdk
*.vdi
*.vhd
*.vhdx
*.img
*.raw
*.nvram
