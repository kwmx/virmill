# Local credentials. Public keys and example configuration remain reviewable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.ssh/
secrets/
credentials/
id_rsa
id_ecdsa
id_ecdsa_sk
id_ed25519
id_ed25519_sk
*.key
*.pem
*.p12
*.pfx

# Transient logs; the append-only release evidence is an intentional deliverable.
*.log
!/docs/evidence/logs/*.log

# Interpreter caches and local editor files.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
