{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virmill.example/schemas/v1/prepared-import.schema.json",
  "title": "Prepared import artifact receipt (no guest boot claim)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "planID",
    "operationID",
    "inputDigest",
    "createdAt",
    "sourceSHA256",
    "system",
    "tool",
    "disks",
    "descriptorSHA256",
    "reportSHA256",
    "vmDefined",
    "guestBootVerified"
  ],
  "properties": {
    "apiVersion": {
      "const": "virmill/v1"
    },
    "kind": {
      "const": "PreparedImport"
    },
    "planID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operationID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "hardware",
        "diskIDs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 2048
        },
        "name": {
          "type": "string",
          "maxLength": 2048
        },
        "hardware": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resourceType",
              "instanceID",
              "parent",
              "addressOnParent",
              "quantity",
              "hostResources",
              "connections"
            ],
            "properties": {
              "resourceType": {
                "type": "string",
                "maxLength": 2048
              },
              "instanceID": {
                "type": "string",
                "maxLength": 2048
              },
              "parent": {
                "type": "string",
                "maxLength": 2048
              },
              "addressOnParent": {
                "type": "string",
                "maxLength": 2048
              },
              "quantity": {
                "type": "string",
                "maxLength": 2048
              },
              "hostResources": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 2048
                }
              },
              "connections": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        },
        "diskIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "disks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceID",
          "sourcePath",
          "path",
          "format",
          "virtualBytes",
          "fileBytes",
          "sha256",
          "sourceChain",
          "verification"
        ],
        "properties": {
          "sourceID": {
            "type": "string",
            "maxLength": 2048
          },
          "sourcePath": {
            "type": "string",
            "maxLength": 2048
          },
          "path": {
            "type": "string",
            "pattern": "^disks/disk-[0-9]{3}\\.qcow2$"
          },
          "format": {
            "const": "qcow2"
          },
          "virtualBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 549755813888
          },
          "fileBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 687211544576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceChain": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object"
            }
          },
          "verification": {
            "const": "virtual-size+qemu-check+qemu-compare"
          }
        }
      }
    },
    "descriptorSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reportSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vmDefined": {
      "const": false
    },
    "guestBootVerified": {
      "const": false
    }
  }
}

