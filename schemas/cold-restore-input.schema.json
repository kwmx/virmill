{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virmill.example/schemas/v1/cold-restore-input.schema.json",
  "title": "Restore a new disconnected VM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "poolID"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f/\\\\\\p{Cf}]"
          }
        }
      ]
    },
    "poolID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
