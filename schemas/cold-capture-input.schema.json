{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virmill.example/schemas/v1/cold-capture-input.schema.json",
  "title": "Stopped VM capture input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceRoot"
  ],
  "properties": {
    "sourceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?:[^/]+/)*[^/]+$",
      "allOf": [
        {
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        {
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f\\\\\\p{Cf}]"
          }
        },
        {
          "not": {
            "pattern": "\\s$"
          }
        }
      ]
    },
    "auxiliaryRootID": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
    }
  }
}
