{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virmill.example/schemas/v1/nocloud-config.schema.json",
  "title": "Explicit declared NoCloud/Netplan IPv4 guest preparation intent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "nocloud-netplan-ipv4-v1"
    },
    "cloudInitCompatible": {
      "const": true
    },
    "sourceDiskID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "sourceSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceReference": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "userName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
    },
    "authorizedKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 16384,
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+=*$"
      }
    },
    "passwordlessSudo": {
      "type": "boolean"
    },
    "ipv6": {
      "const": "disabled"
    },
    "mediaID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "interfaces": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nicID": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "role": {
            "enum": [
              "normal",
              "protected"
            ]
          },
          "mode": {
            "enum": [
              "none",
              "dhcp",
              "static"
            ]
          },
          "address": {
            "type": "string",
            "maxLength": 64
          },
          "gateway": {
            "type": "string",
            "maxLength": 64
          },
          "dns": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "defaultRoute": {
            "type": "boolean"
          },
          "routeMetric": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": [
          "nicID",
          "role",
          "mode",
          "address",
          "gateway",
          "dns",
          "defaultRoute",
          "routeMetric"
        ]
      }
    }
  },
  "required": [
    "profile",
    "cloudInitCompatible",
    "sourceDiskID",
    "sourceSHA256",
    "sourceReference",
    "hostname",
    "userName",
    "authorizedKeys",
    "passwordlessSudo",
    "ipv6",
    "mediaID",
    "interfaces"
  ]
}
