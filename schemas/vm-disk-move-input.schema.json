{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virmill.example/schemas/v1/vm-disk-move-input.schema.json",
  "title": "Move one disk of a stopped VM to another storage pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "pool"],
  "properties": {
    "target": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,31}$"},
    "pool": {"type": "string", "minLength": 1, "maxLength": 255},
    "keepOldCopy": {"type": "boolean"}
  }
}
